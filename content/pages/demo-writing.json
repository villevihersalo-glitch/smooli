{"v":4,"template":"ruled","blocks":[{"id":"w1","x":48,"y":32,"text":"Building in public","bold":true,"size":26},{"id":"w2","x":48,"y":96,"text":"Everything on this site starts as a page in a notebook on my phone. Songs, photos, coffee notes, half-built tools. When a page is ready I tap PUBLISH and it lands here, looking the way it did on paper."},{"id":"w3","x":48,"y":320,"text":"The site is the working example.","italic":true,"spans":[[4,8,"b"]]}],"strokes":[{"id":"s1","kind":"highlighter","color":"#FFE09600","width":14,"anchor":"w1","pts":[0,34,70,33,140,34]},{"id":"s2","kind":"pen","color":"#FFC62F2B","width":2.5,"anchor":"w2","pts":[141.9,149.0,136.9,153.1,129.3,156.5,119.5,159.0,108.2,160.6,96.2,161.0,84.4,160.2,73.5,158.4,64.3,155.6,57.3,151.9,53.1,147.8,52.0,143.4,54.1,139.0,59.1,134.9,66.7,131.5,76.5,129.0,87.8,127.4,99.8,127.0,111.6,127.8,122.5,129.6,131.7,132.4,138.7,136.1,142.9,140.2,144.0,144.6,141.9,149.0]},{"id":"s3","kind":"arrow","color":"#FF1E4FA8","width":2.5,"pts":[360,270,330,236]}]}