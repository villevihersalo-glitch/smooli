{"v":5,"template":"mag-street","blocks":[{"id":"k","x":24,"y":32,"text":"STREET","bold":true,"size":13},{"id":"h","x":24,"y":64,"text":"Bangkok after dark","bold":true,"size":36},{"id":"cap","x":24,"y":496,"text":"Sukhumvit, 23:40. 35 mm, f/2, 1/60 s.","italic":true,"size":13},{"id":"d","x":24,"y":544,"text":"Neon, rain and the hum of a city that never quite sleeps.","italic":true,"size":20},{"id":"by","x":24,"y":640,"text":"Words and pictures by Ville","size":13},{"id":"b","x":24,"y":672,"text":"I walk the same few streets every night with one camera and one lens. The light changes more than the places do: a food cart, a taxi, a sign that flickers on the beat of a song somewhere upstairs."},{"id":"q","x":24,"y":864,"text":"“The light changes more than the places do.”","italic":true,"size":26},{"id":"c2","x":24,"y":1104,"text":"Contact sheet: three frames, one corner.","italic":true,"size":13}],"images":[{"id":"i1","file":"demo-street-1.jpg","x":0,"y":192,"w":393,"h":304},{"id":"i2","file":"demo-street-2.jpg","x":20,"y":976,"w":112.3,"h":128},{"id":"i3","file":"demo-street-3.jpg","x":140.3,"y":976,"w":112.3,"h":128},{"id":"i4","file":"demo-street-4.jpg","x":260.7,"y":976,"w":112.3,"h":128}]}